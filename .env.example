# ===== Copy this file to ".env" and edit the values =====
#   Windows:  copy .env.example .env        Mac/Linux:  cp .env.example .env

# true  = no API key needed; chatbot gives clearly labelled [MOCK RESPONSE] answers; DeepEval/Ragas are disabled
# false = use the real LLM below (requires GEMINI_API_KEY)
MOCK_MODE=true

LLM_PROVIDER=gemini
# Get a free key at https://aistudio.google.com/apikey  and paste it after the "=" (no quotes, no spaces)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Change this to any long random text before sharing/deploying the app
SECRET_KEY=change-this-secret-in-your-env-file

# Default pass thresholds for evaluation metrics (can also be changed in Settings page)
EVAL_THRESHOLD=0.7
HALLUCINATION_THRESHOLD=0.5
