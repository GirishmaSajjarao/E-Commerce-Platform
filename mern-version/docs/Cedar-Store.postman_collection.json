{
  "info": {
    "name": "Cedar Store MERN API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "customerPassword",
      "value": "Customer@123"
    },
    {
      "key": "adminPassword",
      "value": "Admin@123"
    }
  ],
  "item": [
    {
      "name": "Customer checkout",
      "item": [
        {
          "name": "API health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          }
        },
        {
          "name": "Sign in as Alice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"{{customerPassword}}\"\n}"
            }
          }
        },
        {
          "name": "Browse products",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products"
          }
        },
        {
          "name": "Add water bottle",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/cart/items/PRD-103",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 1\n}"
            }
          }
        },
        {
          "name": "Read cart",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/cart"
          }
        },
        {
          "name": "Confirm COD checkout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/checkout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"cod\",\n  \"delivery\": \"standard\",\n  \"idempotencyKey\": \"{{$guid}}\",\n  \"address\": {\n    \"name\": \"Sample Buyer\",\n    \"phone\": \"555-1234\",\n    \"street\": \"1 Sample Lane\",\n    \"city\": \"Sample City\",\n    \"postalCode\": \"10001\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('orderNumber', pm.response.json().order.number);"
                ]
              }
            }
          ]
        },
        {
          "name": "Read order",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/my/orders/{{orderNumber}}"
          }
        }
      ]
    },
    {
      "name": "Admin fulfillment",
      "item": [
        {
          "name": "Sign in as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@qa.local\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          }
        },
        {
          "name": "Begin processing",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/orders/{{orderNumber}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Processing\"\n}"
            }
          }
        },
        {
          "name": "Ship order",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/orders/{{orderNumber}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Shipped\",\n  \"carrier\": \"Sample Carrier\",\n  \"tracking\": \"SAMPLE-001\"\n}"
            }
          }
        },
        {
          "name": "Read sales summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/sales-summary"
          }
        },
        {
          "name": "Run security checks",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/qa/security/run",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('runId', pm.response.json()._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Read QA results",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/qa/runs/{{runId}}"
          }
        }
      ]
    },
    {
      "name": "Customer support",
      "item": [
        {
          "name": "Sign in as Alice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"{{customerPassword}}\"\n}"
            }
          }
        },
        {
          "name": "Start support conversation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/chat/conversations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderNumber\": \"{{orderNumber}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('conversationId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ask about tracking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/chat/conversations/{{conversationId}}/messages",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Where is my order {{orderNumber}}?\"\n}"
            }
          }
        }
      ]
    }
  ]
}
